{
  "name": "mini-linear-jira",
  "version": "1.0.0",
  "description": "Mini-Linear/Jira application monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:backend": "cd apps/backend && npm run dev",
    "start:frontend": "cd apps/frontend && npm run dev",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.0.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3"
  }
}
